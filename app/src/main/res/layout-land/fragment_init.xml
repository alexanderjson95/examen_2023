<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/theme_one_backdrop"
    android:padding="16dp">
    <!-- MENU -->


    <!-- Space between menu and loginform -->



    <ImageView
        android:layout_width="284dp"
        android:layout_height="84dp"
        android:src="@drawable/outlinedlogo" />
    
    <com.google.android.material.button.MaterialButton
        android:id="@+id/regBtn"
        android:text="@string/createaccount"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:layout_marginStart="12dp"
        android:backgroundTint="@color/theme_one_inactiveBtn"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginBtn"
        android:text="@string/login"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:fontFamily="sans-serif"
        android:textColor="@color/black"
        android:backgroundTint="@color/theme_one_activeBtn"
        android:textStyle="bold" />

</LinearLayout>