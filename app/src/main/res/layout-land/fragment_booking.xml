<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/dark_gray_1">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">
        <com.prolificinteractive.materialcalendarview.MaterialCalendarView
            android:id="@+id/calendarView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/dark_gray_1"
            app:mcv_selectionColor="@color/bluepurple_button_active"
            app:mcv_weekDayTextAppearance="@style/CalendarWeekTextDark"
            app:mcv_dateTextAppearance="@style/CalendarDateTextDark"
            app:mcv_headerTextAppearance="@style/CalendarHeaderTextDark"
            app:mcv_showOtherDates="all"
            app:mcv_selectionMode="single"
            app:mcv_firstDayOfWeek="monday" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/setTimeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@drawable/enabled_btn_selector"
            android:text="Skapa bokning" />




        <com.google.android.material.button.MaterialButton
            android:id="@+id/removeTimeBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            android:textColor="@color/black"
            android:text="Ta bort bokning" />

    </LinearLayout>
    </LinearLayout>

</ScrollView>