<!--            app:argType="long" />-->
<!--        <argument-->
<!--            android:name="userId"-->
<!--            app:argType="long" />-->
<!--    </fragment>-->


    <!-- Ändra användare -->

    <fragment
        android:id="@+id/navigation_user_settings"
        android:name="com.example.frontend_android.ui.userSettings.UserSettingsFragment"
        android:label="@string/username"
        tools:layout="@layout/fragment_user_settings">
    </fragment>


    <!-- Lägg till bokning/tillänglighet på schema -->


    <dialog
        android:id="@+id/navigation_booking_dialog"
        android:name="com.example.frontend_android.ui.userProject.schedule.BookingDialog"
        tools:layout="@layout/add_booking_form">
        <argument
            android:name="dateMillis"
            app:argType="long" />
<!--        <argument-->
<!--            android:name="selectedProject"-->
<!--            app:argType="string" />-->

<!--        <argument-->
<!--            android:name="selectedUser"-->
<!--            app:argType="string" />-->
        <argument
            android:name="startHour"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="startMin"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="endHour"
            app:argType="integer"
            android:defaultValue="0" />
        <argument
            android:name="endMin"
            app:argType="integer"
            android:defaultValue="0" />
    </dialog>


    <!-- Settings för projekt -->

    <fragment
        android:id="@+id/navigation_user_project_settings"
        android:name="com.example.frontend_android.ui.userProject.settings.MyProjectSettings"
        tools:layout="@layout/fragment_my_project_settings">

        <argument
            android:name="projectId"
            app:argType="long" />

        <argument
            android:name="userId"
            app:argType="long" />
    </fragment>




</navigation>
